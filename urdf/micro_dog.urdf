<?xml version="1.0"?>
<!-- micro_dog
     description:   Micro Dog quadruped, self-modelled parts inspired by Rhoban Microban (Dynamixel XL330-M288-T x12)
     source_cad:    전체.iam (Autodesk Inventor 2027)
     frame:         ROS/URDF convention: +X forward, +Y left, +Z up
     zero_pose:     CAD assembly pose = every servo at its centre (2048 ticks / 180 deg); thigh points straight back, shank points straight down
     knee_linkage:  parallelogram four-bar (crank 19.0 mm, pushrod 95.0 mm) -> exact 1:1 coupling, modelled as a single revolute joint like Go2
     generated by tools/generate_urdf.py - edit upstream sources, not this file
-->
